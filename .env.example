# Laura A.I. - configuracao principal
# Este arquivo reflete a versao oficial baseada em JarvisV2.py.

# IA principal usada pelo fluxo atual
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# Compatibilidade com provedor alternativo
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL_NAME=openai/gpt-oss-120b:free

# Servicos usados por skills e consultas externas
YOUTUBE_API_KEY=your_youtube_api_key_here
WEATHER_API_KEY=your_weather_api_key_here
NEWS_API_KEY=your_news_api_key_here
CRICKET_API_KEY=your_cricket_api_key_here

# Seguranca da auto-programacao
JARVIS_AUTH_CODE=your_private_auth_code_here

# Compatibilidade legada
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT=

# Google Calendar (OAuth2) — coloque o client_secret.json na pasta credentials/
# Siga: console.cloud.google.com > Novo Projeto > Ativar Calendar API > Credenciais OAuth Desktop
GOOGLE_CALENDAR_CREDENTIALS=credentials/client_secret.json

# Visual Assets — Bancos de imagens e vídeos gratuitos
# Pexels: https://www.pexels.com/api/ (200 req/hora, grátis)
PEXELS_API_KEY=your_pexels_api_key_here
# Unsplash: https://unsplash.com/developers (50 req/hora, grátis)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Azure Speech TTS — Fallback de locução para vídeos (500k chars/mês GRÁTIS, vozes PT-BR nativas)
# Crie um recurso gratuito em: portal.azure.com > Create Resource > Azure AI Speech > F0 (Free)
AZURE_SPEECH_KEY=sua_chave_azure_aqui
AZURE_SPEECH_REGION=eastus
# Vozes PT-BR disponíveis: pt-BR-DonatoNeural (padrão), pt-BR-AntonioNeural,
# pt-BR-BrendaNeural, pt-BR-GiovannaNeural, pt-BR-ThalitaMultilingualNeural
AZURE_TTS_VOICE=pt-BR-DonatoNeural
